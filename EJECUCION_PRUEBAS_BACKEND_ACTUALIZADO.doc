<tr><td>CONC-C</td><td>RQ-ORD-01,RQ-CONC-01</td><td>Stock 50, 2x40 paralelo</td><td>Una 201, otra 409 <code>STOCK_AGOTADO</code>, stock 10</td><td>Cumplido</td><td class='ok'>APROBADO</td><td>Misma prueba</td></tr>
<tr><td>CONC-D</td><td>RQ-CONC-01</td><td>Compra y edición simultáneas</td><td>Sin restaurar/perder descuento</td><td>Cumplido</td><td class='ok'>APROBADO</td><td>Misma prueba</td></tr>
<tr><td>FLU-01</td><td>RQ-CAR-01,RQ-ORD-02/03/04,RQ-CAT-01</td><td>Carrito merge, retiro/domicilio, idempotencia, borrado lógico, cancelación</td><td>Estados/stock/vínculo consistentes</td><td>Cumplido</td><td class='ok'>APROBADO</td><td><code>Etapa6PostgresTests.FlujosCheckout_CarritoMerge_RetiroDomicilio_BorradoLogico_Idempotencia</code></td></tr>
<tr><td>AMP-01</td><td>RQ-LOG-01</td><td>Transferencia atómica, xmin, filtros geográficos (PG)</td><td>Consistencia transaccional</td><td>Cumplido</td><td class='ok'>APROBADO</td><td><code>AmpliacionesPostgresTests.TransferenciaAtomica_EdicionConXmin_YFiltrosGeograficos_FuncionanEnPostgres</code></td></tr>
<tr><td>REG-01</td><td>RQ-LOG-01</td><td>Integración existente no-PG</td><td>Sin regresión</td><td>15/15</td><td class='ok'>APROBADO</td><td>IntegrationTests</td></tr>
<tr><td>AUTO-ALG</td><td>RQ-ALG-01,RQ-ALG-03</td><td>Unitarias algoritmos</td><td>Casos en verde</td><td>54/54</td><td class='ok'>APROBADO</td><td>UnitTests</td></tr>
