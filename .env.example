# Copy to .env and replace every placeholder before starting the local stack.
POSTGRES_DB=delivery
POSTGRES_USER=delivery
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_LOCAL_PASSWORD
JWT_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
BOOTSTRAP_USER=
BOOTSTRAP_PASSWORD=

# PayPal remains disabled locally unless Sandbox credentials are deliberately configured.
PAYPAL_ENABLED=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
